{
  "name": "kalandra",
  "version": "0.18.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node build/script.mjs",
    "build": "tsc --noEmit && node build/script.mjs --prod",
    "package": "electron-builder build",
    "lint": "eslint --ext .ts,.mjs src specs build",
    "fix": "eslint --ext .ts,.mjs src specs build --fix",
    "check-types": "tsc --noemit",
    "test": "vitest run",
    "format": "prettier . --write "
  },
  "author": {
    "name": "davidcristian"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davidcristian/Kalandra.git"
  },
  "main": "dist/main.js",
  "dependencies": {
    "electron-overlay-window": "4.0.2",
    "uiohook-napi": "1.5.x"
  },
  "devDependencies": {
    "@types/ini": "^4.1.0",
    "@types/node": "24.x.x",
    "@types/ws": "^8.5.3",
    "@vitest/coverage-v8": "^4.1.12",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "ini": "^6.0.0",
    "neostandard": "^0.14.1",
    "prettier": "3.4.2",
    "typescript": "5.9.x",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "electron-overlay-window@4.0.2": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "uiohook-napi@1.5.4": true
  }
}
